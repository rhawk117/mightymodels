{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "cwd": "${PLUGIN_ROOT}",
        "env": {
          "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache",
          "PYTHONSAFEPATH": "1",
          "PYTHONUNBUFFERED": "1"
        },
        "command": "uv run --frozen --no-dev --quiet mightymodels_plugin session-bootstrap --plugin-root \"${PLUGIN_ROOT}\"",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "matcher": "^ask_user$",
        "cwd": "${PLUGIN_ROOT}",
        "env": {
          "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache",
          "PYTHONSAFEPATH": "1",
          "PYTHONUNBUFFERED": "1"
        },
        "command": "uv run --frozen --no-dev --quiet mightymodels_plugin decision-recorder --plugin-root \"${PLUGIN_ROOT}\"",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "cwd": "${PLUGIN_ROOT}",
        "env": {
          "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache",
          "PYTHONSAFEPATH": "1",
          "PYTHONUNBUFFERED": "1"
        },
        "command": "uv run --frozen --no-dev --quiet mightymodels_plugin subagent-recorder --plugin-root \"${PLUGIN_ROOT}\"",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "cwd": "${PLUGIN_ROOT}",
        "env": {
          "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache",
          "PYTHONSAFEPATH": "1",
          "PYTHONUNBUFFERED": "1"
        },
        "command": "uv run --frozen --no-dev --quiet mightymodels_plugin completion-gate --plugin-root \"${PLUGIN_ROOT}\"",
        "timeoutSec": 20
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "cwd": "${PLUGIN_ROOT}",
        "env": {
          "UV_CACHE_DIR": "${PLUGIN_DATA}/uv-cache",
          "PYTHONSAFEPATH": "1",
          "PYTHONUNBUFFERED": "1"
        },
        "command": "uv run --frozen --no-dev --quiet mightymodels_plugin workflow-state-snapshot --plugin-root \"${PLUGIN_ROOT}\"",
        "timeoutSec": 30
      }
    ]
  }
}
