{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^mightymodels:triage:(code-scout|web-scout)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" subagent-record",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" subagent-handback",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" ask-recorder",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_mightymodels_mighty-mcp__(ticket_write|ticket_validate|ticket_show|ticket_update_context|close_check|close_ticket|task_declare|task_start|task_verify|task_mark|task_show|task_ready|failed_fix_record|review_start|snapshot_take|crashout_add|investigation_add|investigation_render|investigation_knowns)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" session-pointer",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
